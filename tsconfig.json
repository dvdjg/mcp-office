{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020", "DOM"], // Added DOM for Office JS types if needed client-side simulation
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "baseUrl": ".", // Allows path mapping
    "paths": {
      "@/*": ["src/*"] // Example path mapping
    },
    "sourceMap": true, // Generate source maps for debugging
    "declaration": true, // Generate .d.ts files
    "isolatedModules": true // Recommended by ts-jest for NodeNext module kind
  },
  "include": ["src/**/*"], // Include all files in src
  "exclude": ["node_modules", "dist", "tests"] // Exclude unnecessary directories
}