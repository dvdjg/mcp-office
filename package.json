{
  "name": "msoffice-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Microsoft Office Automation using FastMCP",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server/index.js",
    "dev": "tsc-watch --onSuccess \"tsc-alias && node dist/server/index.js\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "docs:api": "typedoc --out docs/api --entryPoints src/tools src/resources --excludePrivate"
  },
  "keywords": [
    "mcp",
    "fastmcp",
    "office",
    "automation",
    "word",
    "excel",
    "powerpoint",
    "typescript"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "dependencies": {
    "@microsoft/office-js": "^1.1.84",
    "fastmcp": "latest",
    "fs-extra": "^11.2.0",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^10.9.0",
    "node-cache": "^5.1.2",
    "pdf-parse": "^1.1.1",
    "winax": "latest",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.12.12",
    "@types/node-fetch": "^2.6.12",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "pdf2pic": "^3.1.4",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.15",
    "tsc-watch": "^6.2.0",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
