{
  "name": "msoffice-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Microsoft Office Automation using FastMCP",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server/index.js",
    "dev": "tsc-watch --onSuccess \"tsc-alias && node dist/server/index.js\"",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:e2e": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e",
    "test:single": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint . --ext .ts",
    "docs:api": "typedoc --out docs/api --entryPoints src/tools src/resources --excludePrivate"
  },
  "keywords": [
    "mcp",
    "fastmcp",
    "office",
    "automation",
    "word",
    "excel",
    "powerpoint",
    "typescript"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "dependencies": {
    "@microsoft/office-js": "^1.1.84",
    "@vscode/vscode-languagedetection": "^1.0.22",
    "adm-zip": "^0.5.16",
    "axios": "^1.9.0",
    "docx": "^9.5.0",
    "exceljs": "^4.4.0",
    "fastmcp": "latest",
    "fs-extra": "^11.2.0",
    "highlight.js": "^11.9.0",
    "mammoth": "^1.9.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^10.9.0",
    "node-7z": "^3.0.0",
    "node-cache": "^5.1.2",
    "node-html-parser": "^7.0.1",
    "officeparser": "^5.1.1",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^4.0.0",
    "winax": "latest",
    "winston": "^3.13.0",
    "zod": "^3.23.8",
    "papaparse": "^5.4.1",
    "jsonpath-plus": "^7.2.0",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.11.1",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/cheerio": "^0.22.35",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.12.12",
    "@types/node-7z": "^2.1.10",
    "@types/node-fetch": "^2.6.12",
    "@types/papaparse": "^5.3.14",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-strikethrough-alt": "^1.0.0",
    "node-fetch": "^3.3.2",
    "pdf2pic": "^3.1.4",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.15",
    "tsc-watch": "^6.2.0",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5"
  }
}
